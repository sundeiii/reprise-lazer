<?xml version="1.0" encoding="utf-8"?>
<!-- Reprise: our own builds of packages (osu-framework with WASAPI exclusive mode: github.com/sundeiii/osu-framework, branch reprise; a new build gets a new version, as NuGet caches by version), beside nuget.org. -->
<configuration>
  <packageSources>
    <add key="reprise-local" value="LocalPackages" />
  </packageSources>
</configuration>
